#include <windows.h>

1 ICON "app.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName",      "DockCalendar"
            VALUE "FileDescription",  "Всплывающий календарь у кнопки панели (PowerToys Dock)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "DockCalendar"
            VALUE "OriginalFilename", "DockCalendar.exe"
            VALUE "ProductName",      "Dock Calendar"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
